<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instruksi Pembayaran - KuzeTopUp</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- QR Code Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>
<body>

    <div id="toastContainer" class="toast-container" aria-live="polite"></div>

    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <i class="fas fa-bolt"></i>
                <span>Kuze<b>TopUp</b></span>
            </div>
            <div class="nav-auth">
                <a href="/history" class="btn-nav-login">
                    <i class="fas fa-clock-rotate-left"></i> Riwayat
                </a>
                <div class="nav-user">
                    <i class="fas fa-circle-user"></i>
                    <span><%= user.username %></span>
                </div>
                <form action="/logout" method="POST" style="margin:0">
                    <button type="submit" class="btn-logout">
                        <i class="fas fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <section class="payment-page">

        <!-- HEADER -->
        <div class="payment-header">
            <div class="payment-status-badge">
                <i class="fas fa-clock"></i> Menunggu Pembayaran
            </div>
            <h1>Selesaikan Pembayaran</h1>
            <p>Sebelum waktu habis, segera lakukan pembayaran</p>

            <!-- COUNTDOWN -->
            <div class="payment-countdown">
                <i class="fas fa-hourglass-half"></i>
                <span id="countdown">30:00</span>
            </div>
        </div>

        <div class="payment-layout">

            <!-- KIRI: DETAIL ORDER -->
            <div class="payment-detail-card">
                <h3><i class="fas fa-receipt"></i> Detail Pesanan</h3>
                <div class="payment-detail-list">
                    <div>
                        <span>Kode Transaksi</span>
                        <code><%= transaction.code %></code>
                    </div>
                    <div>
                        <span>Game</span>
                        <strong><%= transaction.game %></strong>
                    </div>
                    <div>
                        <span>Nominal</span>
                        <strong><%= transaction.nominal %></strong>
                    </div>
                    <div>
                        <span>User ID Game</span>
                        <strong><%= transaction.game_user_id %></strong>
                    </div>
                    <% if (transaction.server_id) { %>
                    <div>
                        <span>Server ID</span>
                        <strong><%= transaction.server_id %></strong>
                    </div>
                    <% } %>
                    <div>
                        <span>Metode Pembayaran</span>
                        <strong><%= transaction.payment %></strong>
                    </div>
                    <div class="payment-total-row">
                        <span>Total Bayar</span>
                        <strong>Rp <%= transaction.total.toLocaleString('id-ID') %></strong>
                    </div>
                </div>
            </div>

            <!-- KANAN: INSTRUKSI PEMBAYARAN -->
            <div class="payment-instruction-card">
                <h3><i class="fas fa-info-circle"></i> Instruksi Pembayaran</h3>

                <!-- QRIS -->
                <% if (transaction.payment === 'QRIS') { %>
                <div class="payment-method-info">
                    <div class="qris-box">
                        <!-- Badge DEMO -->
                        <div class="qris-demo-badge">
                            <i class="fas fa-flask"></i> DEMO — Tidak ada uang nyata
                        </div>

                        <!-- Header QRIS bergambar -->
                        <div class="qris-header-bar">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/a/a4/QRIS_logo.svg/320px-QRIS_logo.svg.png"
                                 alt="QRIS" class="qris-logo-img" onerror="this.style.display='none'">
                            <span class="qris-header-title">KuzeTopUp</span>
                        </div>

                        <!-- QR Code Canvas -->
                        <div class="qris-canvas-wrap">
                            <canvas id="qrisCanvas"></canvas>
                        </div>

                        <!-- Nominal di bawah QR -->
                        <div class="qris-amount-label">
                            <span>Nominal Pembayaran</span>
                            <strong>Rp <%= transaction.total.toLocaleString('id-ID') %></strong>
                        </div>

                        <!-- Kode transaksi -->
                        <div class="qris-txcode">
                            <i class="fas fa-hashtag"></i> <%= transaction.code %>
                        </div>

                        <small class="qris-note">
                            <i class="fas fa-circle-info"></i>
                            Scan QR ini dengan aplikasi e-wallet apapun
                        </small>

                        <!-- Tombol Download QR -->
                        <button class="btn-download-qr" onclick="downloadQR()">
                            <i class="fas fa-download"></i> Download QR
                        </button>
                    </div>

                    <div class="payment-steps">
                        <div class="step"><span>1</span> Buka aplikasi e-wallet kamu</div>
                        <div class="step"><span>2</span> Pilih fitur Scan / QRIS</div>
                        <div class="step"><span>3</span> Scan QR di atas</div>
                        <div class="step"><span>4</span> Bayar sebesar <strong>Rp <%= transaction.total.toLocaleString('id-ID') %></strong></div>
                        <div class="step"><span>5</span> Screenshot bukti pembayaran</div>
                    </div>
                </div>

                <!-- DANA / OVO / GoPay / ShopeePay -->
                <% } else if (['DANA', 'OVO', 'GoPay', 'ShopeePay'].includes(transaction.payment)) { %>
                <div class="payment-method-info">
                    <div class="transfer-box">
                        <div class="transfer-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div class="transfer-detail">
                            <p class="transfer-label">Nomor <%= transaction.payment %></p>
                            <p class="transfer-number" onclick="copyText('08123456789', this)">
                                08123456789
                                <i class="fas fa-copy"></i>
                            </p>
                            <p class="transfer-name">a.n. KuzeTopUp Store</p>
                        </div>
                    </div>
                    <div class="payment-steps">
                        <div class="step"><span>1</span> Buka aplikasi <%= transaction.payment %></div>
                        <div class="step"><span>2</span> Pilih Transfer / Kirim Uang</div>
                        <div class="step"><span>3</span> Masukkan nomor <strong>08123456789</strong></div>
                        <div class="step"><span>4</span> Masukkan nominal <strong>Rp <%= transaction.total.toLocaleString('id-ID') %></strong></div>
                        <div class="step"><span>5</span> Screenshot bukti transfer</div>
                    </div>
                </div>

                <!-- BANK TRANSFER -->
                <% } else if (transaction.payment === 'Bank Transfer') { %>
                <div class="payment-method-info">
                    <div class="bank-tabs">
                        <button class="bank-tab active" onclick="switchBank(this, 'bca')">BCA</button>
                        <button class="bank-tab" onclick="switchBank(this, 'bri')">BRI</button>
                        <button class="bank-tab" onclick="switchBank(this, 'mandiri')">Mandiri</button>
                        <button class="bank-tab" onclick="switchBank(this, 'bni')">BNI</button>
                    </div>
                    <div class="bank-info" id="bank-bca">
                        <div class="transfer-box">
                            <div class="transfer-icon"><i class="fas fa-building-columns"></i></div>
                            <div class="transfer-detail">
                                <p class="transfer-label">BCA</p>
                                <p class="transfer-number" onclick="copyText('1234567890', this)">
                                    1234567890 <i class="fas fa-copy"></i>
                                </p>
                                <p class="transfer-name">a.n. KuzeTopUp Store</p>
                            </div>
                        </div>
                    </div>
                    <div class="bank-info" id="bank-bri" style="display:none">
                        <div class="transfer-box">
                            <div class="transfer-icon"><i class="fas fa-building-columns"></i></div>
                            <div class="transfer-detail">
                                <p class="transfer-label">BRI</p>
                                <p class="transfer-number" onclick="copyText('0987654321', this)">
                                    0987654321 <i class="fas fa-copy"></i>
                                </p>
                                <p class="transfer-name">a.n. KuzeTopUp Store</p>
                            </div>
                        </div>
                    </div>
                    <div class="bank-info" id="bank-mandiri" style="display:none">
                        <div class="transfer-box">
                            <div class="transfer-icon"><i class="fas fa-building-columns"></i></div>
                            <div class="transfer-detail">
                                <p class="transfer-label">Mandiri</p>
                                <p class="transfer-number" onclick="copyText('1122334455', this)">
                                    1122334455 <i class="fas fa-copy"></i>
                                </p>
                                <p class="transfer-name">a.n. KuzeTopUp Store</p>
                            </div>
                        </div>
                    </div>
                    <div class="bank-info" id="bank-bni" style="display:none">
                        <div class="transfer-box">
                            <div class="transfer-icon"><i class="fas fa-building-columns"></i></div>
                            <div class="transfer-detail">
                                <p class="transfer-label">BNI</p>
                                <p class="transfer-number" onclick="copyText('5566778899', this)">
                                    5566778899 <i class="fas fa-copy"></i>
                                </p>
                                <p class="transfer-name">a.n. KuzeTopUp Store</p>
                            </div>
                        </div>
                    </div>
                    <div class="payment-steps">
                        <div class="step"><span>1</span> Buka aplikasi/ATM bank pilihanmu</div>
                        <div class="step"><span>2</span> Pilih Transfer ke rekening di atas</div>
                        <div class="step"><span>3</span> Masukkan nominal tepat <strong>Rp <%= transaction.total.toLocaleString('id-ID') %></strong></div>
                        <div class="step"><span>4</span> Screenshot bukti transfer</div>
                    </div>
                </div>
                <% } %>

                <!-- UPLOAD BUKTI -->
                <div class="upload-section">
                    <h4><i class="fas fa-upload"></i> Upload Bukti Pembayaran</h4>
                    <% if (transaction.proof_image) { %>
                        <div class="proof-uploaded">
                            <i class="fas fa-circle-check"></i>
                            <p>Bukti sudah diupload! Menunggu konfirmasi admin.</p>
                            <img src="/uploads/<%= transaction.proof_image %>" alt="Bukti Transfer">
                        </div>
                    <% } else { %>
                        <div class="upload-area" id="uploadArea" onclick="document.getElementById('proofFile').click()">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <p>Klik atau drag foto bukti transfer</p>
                            <small>Format: JPG, PNG, maksimal 2MB</small>
                        </div>
                        <input type="file" id="proofFile" accept="image/*" style="display:none" onchange="previewFile(this)">
                        <div id="previewBox" style="display:none">
                            <img id="previewImg" src="" alt="Preview">
                            <button type="button" class="btn-upload-submit" id="btnUpload" onclick="uploadProof()">
                                <i class="fas fa-paper-plane"></i> Kirim Bukti
                            </button>
                        </div>
                    <% } %>
                </div>

            </div>
        </div>
    </section>

    <!-- ─── QRIS STYLES ─────────────────────────────────────────── -->
    <style>
        .qris-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: #fff;
            border-radius: 20px;
            border: 2px solid #e8e8e8;
            padding: 20px 24px 16px;
            max-width: 280px;
            margin: 0 auto 20px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        .qris-demo-badge {
            background: linear-gradient(135deg, #ff6b35, #f7931e);
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 20px;
            margin-bottom: 12px;
            letter-spacing: 0.5px;
        }
        .qris-header-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            border-bottom: 2px solid #e8e8e8;
            width: 100%;
            padding-bottom: 10px;
            margin-bottom: 14px;
            justify-content: center;
        }
        .qris-logo-img {
            height: 22px;
            object-fit: contain;
        }
        .qris-header-title {
            font-size: 14px;
            font-weight: 700;
            color: #333;
            letter-spacing: 1px;
        }
        .qris-canvas-wrap {
            background: #fff;
            padding: 10px;
            border-radius: 12px;
            border: 1.5px solid #eee;
            margin-bottom: 14px;
        }
        .qris-canvas-wrap canvas,
        .qris-canvas-wrap img {
            display: block;
            border-radius: 6px;
        }
        .qris-amount-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            margin-bottom: 8px;
        }
        .qris-amount-label span {
            font-size: 11px;
            color: #888;
        }
        .qris-amount-label strong {
            font-size: 18px;
            font-weight: 700;
            color: #1a1a2e;
        }
        .qris-txcode {
            font-size: 11px;
            color: #aaa;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }
        .qris-note {
            font-size: 11px;
            color: #999;
            text-align: center;
            margin-bottom: 12px;
            line-height: 1.5;
        }
        .btn-download-qr {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff;
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-download-qr:hover { opacity: 0.85; }
    </style>

    <script>
        const transactionCode = '<%= transaction.code %>';
        const transactionPayment = '<%= transaction.payment %>';
        const transactionTotal = <%= transaction.total %>;

        // ─── GENERATE QRIS ────────────────────────────────────────────
        if (transactionPayment === 'QRIS') {
            window.addEventListener('DOMContentLoaded', () => {
                // Format data QRIS demo (simulasi format QRIS Indonesia)
                const qrisData = [
                    '000201',                        // Payload Format Indicator
                    '010212',                        // Point of Initiation Method (dynamic)
                    '2659',                          // Merchant Account
                    '0014ID.CO.KUZETOPUP',           // Merchant identifier
                    '0115KuzeTopUp Store',
                    '52044816',                      // Merchant Category Code (game)
                    '5303360',                       // Transaction Currency (IDR)
                    '54' + String(transactionTotal).length.toString().padStart(2,'0') + transactionTotal,
                    '5802ID',                        // Country Code
                    '5913KuzeTopUp',                 // Merchant Name
                    '6013Jakarta Pusat',             // Merchant City
                    '6215' + transactionCode,        // Reference / Kode Transaksi
                    '6304'                           // CRC placeholder
                ].join('');

                const canvas = document.getElementById('qrisCanvas');
                QRCode.toCanvas(canvas, qrisData, {
                    width: 200,
                    margin: 1,
                    color: {
                        dark: '#1a1a2e',
                        light: '#ffffff'
                    },
                    errorCorrectionLevel: 'M'
                }, (err) => {
                    if (err) console.error('QR Error:', err);
                });
            });
        }

        // ─── DOWNLOAD QR ──────────────────────────────────────────────
        function downloadQR() {
            const canvas = document.getElementById('qrisCanvas');
            if (!canvas) return;
            const link = document.createElement('a');
            link.download = `QRIS-${transactionCode}.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();
            showToast('QR Code berhasil didownload!', 'success');
        }

        // ─── COUNTDOWN ────────────────────────────────────────────────
        let timeLeft = 30 * 60;
        const countdownEl = document.getElementById('countdown');

        const timer = setInterval(() => {
            timeLeft--;
            const m = String(Math.floor(timeLeft / 60)).padStart(2, '0');
            const s = String(timeLeft % 60).padStart(2, '0');
            countdownEl.textContent = `${m}:${s}`;
            if (timeLeft <= 0) {
                clearInterval(timer);
                countdownEl.textContent = 'Waktu habis!';
                countdownEl.style.color = 'var(--secondary)';
            }
        }, 1000);

        // ─── COPY TEXT ────────────────────────────────────────────────
        function copyText(text, el) {
            navigator.clipboard.writeText(text).then(() => {
                el.classList.add('copied');
                showToast('Disalin!', 'success');
                setTimeout(() => el.classList.remove('copied'), 2000);
            });
        }

        // ─── SWITCH BANK TAB ──────────────────────────────────────────
        function switchBank(btn, bank) {
            document.querySelectorAll('.bank-tab').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.bank-info').forEach(b => b.style.display = 'none');
            btn.classList.add('active');
            document.getElementById('bank-' + bank).style.display = 'block';
        }

        // ─── PREVIEW FILE ─────────────────────────────────────────────
        function previewFile(input) {
            const file = input.files[0];
            if (!file) return;
            if (file.size > 2 * 1024 * 1024) {
                showToast('File terlalu besar! Maksimal 2MB', 'error');
                return;
            }
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('previewBox').style.display = 'block';
                document.getElementById('uploadArea').style.display = 'none';
            };
            reader.readAsDataURL(file);
        }

        // ─── UPLOAD BUKTI ─────────────────────────────────────────────
        async function uploadProof() {
            const file = document.getElementById('proofFile').files[0];
            if (!file) return;

            const btn = document.getElementById('btnUpload');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengirim...';

            const formData = new FormData();
            formData.append('proof', file);
            formData.append('code', transactionCode);

            try {
                const res = await fetch('/upload-proof', { method: 'POST', body: formData });
                const data = await res.json();

                if (data.success) {
                    showToast('Bukti berhasil dikirim! Menunggu konfirmasi admin.', 'success');
                    setTimeout(() => location.reload(), 2000);
                } else {
                    showToast(data.error || 'Gagal upload!', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Kirim Bukti';
                }
            } catch {
                showToast('Gagal terhubung ke server!', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Kirim Bukti';
            }
        }

        // ─── TOAST ────────────────────────────────────────────────────
        function showToast(message, type = 'error') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            const icon = type === 'error' ? 'fa-circle-xmark' : type === 'success' ? 'fa-circle-check' : 'fa-circle-info';
            toast.innerHTML = `<i class="fas ${icon}"></i><span>${message}</span>`;
            container.appendChild(toast);
            requestAnimationFrame(() => toast.classList.add('toast-show'));
            setTimeout(() => {
                toast.classList.remove('toast-show');
                setTimeout(() => toast.remove(), 350);
            }, 3000);
        }
    </script>
</body>
</html>
