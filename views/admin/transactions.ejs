<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Transaksi - KuzeTopUp</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="admin-body">

    <aside class="admin-sidebar" id="sidebar">
        <div class="sidebar-logo">
            <i class="fas fa-bolt"></i>
            <span>Kuze<b>Admin</b></span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin" class="sidebar-link"><i class="fas fa-chart-pie"></i> Dashboard</a>
            <a href="/admin/users" class="sidebar-link"><i class="fas fa-users"></i> Users</a>
            <a href="/admin/transactions" class="sidebar-link active"><i class="fas fa-receipt"></i> Transaksi</a>
            <a href="/admin/games" class="sidebar-link"><i class="fas fa-gamepad"></i> Games</a>
        </nav>
        <div class="sidebar-footer">
            <div class="sidebar-user">
                <i class="fas fa-circle-user"></i>
                <span><%= user.username %></span>
            </div>
            <form action="/logout" method="POST">
                <button type="submit" class="btn-logout"><i class="fas fa-right-from-bracket"></i> Logout</button>
            </form>
        </div>
    </aside>

    <main class="admin-main">
        <div class="admin-topbar">
            <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
            <h1 class="admin-page-title">Manajemen Transaksi</h1>
            <a href="/" target="_blank" class="btn-visit-site"><i class="fas fa-arrow-up-right-from-square"></i> Lihat Website</a>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <h3><i class="fas fa-receipt"></i> Semua Transaksi (<%= transactions.length %>)</h3>
            </div>
            <% if (transactions.length === 0) { %>
            <div class="admin-empty">
                <i class="fas fa-inbox"></i>
                <p>Belum ada transaksi</p>
            </div>
            <% } else { %>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Kode</th>
                            <th>User</th>
                            <th>Game</th>
                            <th>Nominal</th>
                            <th>User ID Game</th>
                            <th>Pembayaran</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% transactions.forEach(t => { %>
                        <tr>
                            <td><code><%= t.code %></code></td>
                            <td><%= t.username %></td>
                            <td><%= t.game %></td>
                            <td><%= t.nominal %></td>
                            <td><%= t.userId %><% if(t.serverId) { %> / <%= t.serverId %><% } %></td>
                            <td><%= t.payment %></td>
                            <td>Rp <%= t.total.toLocaleString('id-ID') %></td>
                            <td>
                                <span class="badge-status badge-<%= t.status %>">
                                    <%= t.status === 'pending' ? 'Pending' : t.status === 'success' ? 'Sukses' : 'Gagal' %>
                                </span>
                            </td>
                            <td class="td-actions">
                                <form action="/admin/transactions/<%= t.id %>/status" method="POST">
                                    <select name="status" class="select-status" onchange="this.form.submit()">
                                        <option value="pending" <%= t.status === 'pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="success" <%= t.status === 'success' ? 'selected' : '' %>>Sukses</option>
                                        <option value="failed" <%= t.status === 'failed' ? 'selected' : '' %>>Gagal</option>
                                    </select>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>
    </main>

    <script>function toggleSidebar() { document.getElementById('sidebar').classList.toggle('sidebar-open'); }</script>
</body>
</html>
