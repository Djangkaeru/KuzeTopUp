<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Games - KuzeTopUp</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="admin-body">

    <aside class="admin-sidebar" id="sidebar">
        <div class="sidebar-logo">
            <i class="fas fa-bolt"></i>
            <span>Kuze<b>Admin</b></span>
        </div>
        <nav class="sidebar-nav">
            <a href="/admin" class="sidebar-link"><i class="fas fa-chart-pie"></i> Dashboard</a>
            <a href="/admin/users" class="sidebar-link"><i class="fas fa-users"></i> Users</a>
            <a href="/admin/transactions" class="sidebar-link"><i class="fas fa-receipt"></i> Transaksi</a>
            <a href="/admin/games" class="sidebar-link active"><i class="fas fa-gamepad"></i> Games</a>
        </nav>
        <div class="sidebar-footer">
            <div class="sidebar-user">
                <i class="fas fa-circle-user"></i>
                <span><%= user.username %></span>
            </div>
            <form action="/logout" method="POST">
                <button type="submit" class="btn-logout"><i class="fas fa-right-from-bracket"></i> Logout</button>
            </form>
        </div>
    </aside>

    <main class="admin-main">
        <div class="admin-topbar">
            <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
            <h1 class="admin-page-title">Manajemen Games</h1>
            <a href="/" target="_blank" class="btn-visit-site"><i class="fas fa-arrow-up-right-from-square"></i> Lihat Website</a>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">
                <h3><i class="fas fa-gamepad"></i> Daftar Games (<%= games.length %>)</h3>
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Game</th>
                            <th>Kategori</th>
                            <th>Badge</th>
                            <th>Jumlah Paket</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% games.forEach(g => { %>
                        <tr>
                            <td><%= g.id %></td>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px">
                                    <img src="<%= g.icon %>" alt="<%= g.name %>" style="width:36px;height:36px;border-radius:8px;object-fit:cover">
                                    <strong><%= g.name %></strong>
                                </div>
                            </td>
                            <td><%= g.category %></td>
                            <td>
                                <% if (g.badge) { %>
                                <span class="badge-status badge-success"><%= g.badge %></span>
                                <% } else { %>
                                <span style="color:#555">—</span>
                                <% } %>
                            </td>
                            <td><%= g.packages.length %> paket</td>
                            <td>
                                <a href="/game/<%= g.id %>" target="_blank" class="btn-admin-link">
                                    <i class="fas fa-eye"></i> Lihat
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>function toggleSidebar() { document.getElementById('sidebar').classList.toggle('sidebar-open'); }</script>
</body>
</html>
