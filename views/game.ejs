<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= game.name %> - KuzeTopUp</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <i class="fas fa-bolt"></i>
                <span>Kuze<b>TopUp</b></span>
            </div>
            <a href="/" class="btn-back"><i class="fas fa-arrow-left"></i> Kembali</a>
        </div>
    </nav>

    <!-- DETAIL GAME -->
    <section class="game-detail">
        <div class="game-detail-header">
            <div class="game-detail-icon">
                <img src="<%= game.icon %>" alt="<%= game.name %>">
            </div>
            <h1><%= game.name %></h1>
            <p><%= game.category %></p>
        </div>

        <!-- FORM ID -->
        <div class="form-id">
            <h2>Masukkan ID Game</h2>
            <div class="input-group">
                <input type="text" id="userId" placeholder="Masukkan User ID">
                <input type="text" id="serverId" placeholder="Server ID (jika ada)">
            </div>
        </div>

        <!-- PILIH NOMINAL -->
        <div class="nominal-section">
            <h2>Pilih Nominal</h2>
            <div class="nominal-grid">
                <% game.packages.forEach(pkg => { %>
                <div class="nominal-card" onclick="selectNominal(this, '<%= pkg.name %>', <%= pkg.price %>)">
                    <% if (pkg.bonus) { %><span class="badge">+<%= pkg.bonus %></span><% } %>
                    <div class="nominal-icon">
                        <i class="fas fa-gem"></i>
                    </div>
                    <h3><%= pkg.name %></h3>
                    <p>Rp <%= pkg.price.toLocaleString('id-ID') %></p>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- PILIH PEMBAYARAN -->
        <div class="payment-section">
            <h2>Pilih Pembayaran</h2>
            <div class="payment-grid">
                <% paymentMethods.forEach(method => { %>
                <button
                    type="button"
                    class="payment-card"
                    data-payment-name="<%= method.name %>"
                    onclick="selectPayment(this)"
                    aria-pressed="false"
                >
                    <span class="payment-icon">
                        <i class="fas <%= method.icon %>"></i>
                    </span>
                    <span class="payment-copy">
                        <strong><%= method.name %></strong>
                        <small><%= method.description %></small>
                    </span>
                </button>
                <% }) %>
            </div>
        </div>

        <!-- TOMBOL BELI -->
        <div class="buy-section">
            <div class="selected-info" id="selectedInfo" style="display:none">
                <p>Nominal: <span id="selectedName"></span> - <strong id="selectedPrice"></strong></p>
                <p>Pembayaran: <span id="selectedPayment">Belum dipilih</span></p>
            </div>
            <button class="btn-buy" id="btnBuy" onclick="submitOrder()">Lengkapi Order</button>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-content">
            <div class="logo">
                <i class="fas fa-bolt"></i>
                <span>Kuze<b>TopUp</b></span>
            </div>
            <p>&copy; 2026 KuzeTopUp. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/script.js"></script>
    <script>
        let selectedPkg = null;
        let selectedPayment = null;

        function updateBuyState() {
            const btnBuy = document.getElementById('btnBuy');
            const selectedInfo = document.getElementById('selectedInfo');

            selectedInfo.style.display = selectedPkg ? 'block' : 'none';

            if (selectedPkg && selectedPayment) {
                btnBuy.textContent = 'Beli Sekarang';
                btnBuy.classList.add('active');
                return;
            }

            btnBuy.classList.remove('active');
            btnBuy.textContent = selectedPkg ? 'Pilih Pembayaran' : 'Pilih Nominal Dulu';
        }

        function selectNominal(el, name, price) {
            document.querySelectorAll('.nominal-card').forEach(card => card.classList.remove('selected'));
            el.classList.add('selected');
            selectedPkg = { name, price };

            document.getElementById('selectedName').textContent = name;
            document.getElementById('selectedPrice').textContent = 'Rp ' + price.toLocaleString('id-ID');
            updateBuyState();
        }

        function selectPayment(el) {
            document.querySelectorAll('.payment-card').forEach(card => {
                card.classList.remove('selected');
                card.setAttribute('aria-pressed', 'false');
            });

            el.classList.add('selected');
            el.setAttribute('aria-pressed', 'true');
            selectedPayment = el.dataset.paymentName;

            document.getElementById('selectedPayment').textContent = selectedPayment;
            updateBuyState();
        }

        function submitOrder() {
            if (!selectedPkg) {
                alert('Pilih nominal dulu ya!');
                return;
            }

            if (!selectedPayment) {
                alert('Pilih metode pembayaran dulu!');
                return;
            }

            const userId = document.getElementById('userId').value.trim();
            if (!userId) {
                alert('Masukkan User ID dulu!');
                return;
            }

            const serverId = document.getElementById('serverId').value.trim();
            const serverInfo = serverId ? `\nServer ID: ${serverId}` : '';

            alert(`Pesanan berhasil!\n\nGame: <%= game.name %>\nNominal: ${selectedPkg.name}\nUser ID: ${userId}${serverInfo}\nPembayaran: ${selectedPayment}\nTotal: Rp ${selectedPkg.price.toLocaleString('id-ID')}\n\nTerima kasih sudah order di KuzeTopUp!`);
        }
    </script>
</body>
</html>
