<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= game.name %> - KuzeTopUp</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- TOAST NOTIFICATION -->
    <div id="toastContainer" class="toast-container" aria-live="polite"></div>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <i class="fas fa-bolt"></i>
                <span>Kuze<b>TopUp</b></span>
            </div>
            <div class="nav-auth">
                <a href="/" class="btn-back"><i class="fas fa-arrow-left"></i> Kembali</a>
                <a href="/history" class="btn-nav-login">
                    <i class="fas fa-clock-rotate-left"></i> Riwayat
                </a>
                <div class="nav-user">
                    <i class="fas fa-circle-user"></i>
                    <span><%= user.username %></span>
                </div>
                <form action="/logout" method="POST" style="margin:0">
                    <button type="submit" class="btn-logout">
                        <i class="fas fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <!-- DETAIL GAME -->
    <section class="game-detail">
        <div class="game-detail-header">
            <div class="game-detail-icon">
                <img src="<%= game.icon %>" alt="<%= game.name %>">
            </div>
            <h1><%= game.name %></h1>
            <p><%= game.category %></p>
        </div>

        <!-- FORM ID -->
        <div class="form-id">
            <h2>Masukkan ID Game</h2>
            <div class="input-group">
                <div class="input-wrapper">
                    <input
                        type="text"
                        id="userId"
                        placeholder="Masukkan User ID"
                        maxlength="20"
                        autocomplete="off"
                        oninput="validateUserId()"
                    >
                    <span class="input-error" id="userIdError"></span>
                </div>
                <div class="input-wrapper">
                    <input
                        type="text"
                        id="serverId"
                        placeholder="Server ID (jika ada)"
                        maxlength="10"
                        autocomplete="off"
                        oninput="validateServerId()"
                    >
                    <span class="input-error" id="serverIdError"></span>
                </div>
            </div>
        </div>

        <!-- PILIH NOMINAL -->
        <div class="nominal-section">
            <h2>Pilih Nominal</h2>
            <div class="nominal-grid">
                <% game.packages.forEach(pkg => { %>
                <div class="nominal-card" onclick="selectNominal(this, '<%= pkg.name %>', <%= pkg.price %>)">
                    <% if (pkg.bonus) { %><span class="badge">+<%= pkg.bonus %></span><% } %>
                    <div class="nominal-icon">
                        <i class="fas fa-gem"></i>
                    </div>
                    <h3><%= pkg.name %></h3>
                    <p>Rp <%= pkg.price.toLocaleString('id-ID') %></p>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- PILIH PEMBAYARAN -->
        <div class="payment-section">
            <h2>Pilih Pembayaran</h2>
            <div class="payment-grid">
                <% paymentMethods.forEach(method => { %>
                <button
                    type="button"
                    class="payment-card"
                    data-payment-name="<%= method.name %>"
                    onclick="selectPayment(this)"
                    aria-pressed="false"
                >
                    <span class="payment-icon">
                        <i class="fas <%= method.icon %>"></i>
                    </span>
                    <span class="payment-copy">
                        <strong><%= method.name %></strong>
                        <small><%= method.description %></small>
                    </span>
                </button>
                <% }) %>
            </div>
        </div>

        <!-- TOMBOL BELI -->
        <div class="buy-section">
            <div class="selected-info" id="selectedInfo" style="display:none">
                <p>Nominal: <span id="selectedName"></span> - <strong id="selectedPrice"></strong></p>
                <p>Pembayaran: <span id="selectedPayment">Belum dipilih</span></p>
            </div>
            <button class="btn-buy" id="btnBuy" onclick="submitOrder()">Pilih Nominal Dulu</button>
        </div>
    </section>

    <!-- INVOICE -->
    <div class="invoice-modal" id="invoiceModal" role="dialog" aria-modal="true" aria-labelledby="invoiceTitle" hidden>
        <div class="invoice-dialog">
            <div class="invoice-header">
                <div>
                    <p class="invoice-label">Invoice</p>
                    <h2 id="invoiceTitle">Pesanan Dibuat</h2>
                </div>
                <button type="button" class="invoice-close" onclick="closeInvoice()" aria-label="Tutup invoice">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>

            <div class="invoice-status">
                <i class="fas fa-clock"></i>
                <span>Menunggu Pembayaran</span>
            </div>

            <div class="invoice-code">
                <span>Kode Transaksi</span>
                <strong id="invoiceCode">-</strong>
            </div>

            <div class="invoice-list">
                <div>
                    <span>Game</span>
                    <strong id="invoiceGame">-</strong>
                </div>
                <div>
                    <span>Nominal</span>
                    <strong id="invoiceNominal">-</strong>
                </div>
                <div>
                    <span>User ID</span>
                    <strong id="invoiceUserId">-</strong>
                </div>
                <div>
                    <span>Server ID</span>
                    <strong id="invoiceServerId">-</strong>
                </div>
                <div>
                    <span>Pembayaran</span>
                    <strong id="invoicePayment">-</strong>
                </div>
                <div class="invoice-total">
                    <span>Total</span>
                    <strong id="invoiceTotal">-</strong>
                </div>
            </div>

            <div class="invoice-actions">
                <button type="button" class="btn-invoice-secondary" onclick="closeInvoice()">
                    Tutup
                </button>
                <button type="button" class="btn-invoice-primary" onclick="resetOrder()">
                    Pesan Lagi
                </button>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-content">
            <div class="logo">
                <i class="fas fa-bolt"></i>
                <span>Kuze<b>TopUp</b></span>
            </div>
            <p>&copy; 2026 KuzeTopUp. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/script.js"></script>
    <script>
        const gameName = <%- JSON.stringify(game.name) %>;
        const gameId   = <%- JSON.stringify(game.id) %>;
        let selectedPkg = null;
        let selectedPayment = null;

        // ─── TOAST NOTIFICATION ───────────────────────────────────────────
        function showToast(message, type = 'error') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;

            const icon = type === 'error' ? 'fa-circle-xmark'
                       : type === 'success' ? 'fa-circle-check'
                       : 'fa-circle-info';

            toast.innerHTML = `<i class="fas ${icon}"></i><span>${message}</span>`;
            container.appendChild(toast);

            // animasi masuk
            requestAnimationFrame(() => toast.classList.add('toast-show'));

            // hapus setelah 3 detik
            setTimeout(() => {
                toast.classList.remove('toast-show');
                setTimeout(() => toast.remove(), 350);
            }, 3000);
        }

        // ─── FORMAT ───────────────────────────────────────────────────────
        function formatRupiah(value) {
            return 'Rp ' + value.toLocaleString('id-ID');
        }

        function generateTransactionCode() {
            const now = new Date();
            const datePart = [
                now.getFullYear(),
                String(now.getMonth() + 1).padStart(2, '0'),
                String(now.getDate()).padStart(2, '0')
            ].join('');
            const randomPart = Math.floor(1000 + Math.random() * 9000);
            return `KZ-${datePart}-${randomPart}`;
        }

        // ─── SANITASI ─────────────────────────────────────────────────────
        // Hapus karakter berbahaya (XSS protection)
        function sanitize(str) {
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#x27;');
        }

        // ─── VALIDASI USER ID ─────────────────────────────────────────────
        function validateUserId() {
            const input = document.getElementById('userId');
            const errorEl = document.getElementById('userIdError');
            const value = input.value.trim();

            // Hanya boleh huruf, angka, underscore, strip
            const validPattern = /^[a-zA-Z0-9_-]*$/;

            if (value === '') {
                setInputState(input, errorEl, 'default', '');
                return false;
            }

            if (!validPattern.test(value)) {
                setInputState(input, errorEl, 'error', 'Hanya boleh huruf, angka, _ dan -');
                return false;
            }

            if (value.length < 3) {
                setInputState(input, errorEl, 'error', 'Minimal 3 karakter');
                return false;
            }

            setInputState(input, errorEl, 'success', '');
            return true;
        }

        // ─── VALIDASI SERVER ID ───────────────────────────────────────────
        function validateServerId() {
            const input = document.getElementById('serverId');
            const errorEl = document.getElementById('serverIdError');
            const value = input.value.trim();

            // Server ID boleh kosong
            if (value === '') {
                setInputState(input, errorEl, 'default', '');
                return true;
            }

            // Hanya boleh angka
            const validPattern = /^[0-9]*$/;
            if (!validPattern.test(value)) {
                setInputState(input, errorEl, 'error', 'Server ID hanya boleh angka');
                return false;
            }

            setInputState(input, errorEl, 'success', '');
            return true;
        }

        // ─── SET STATE INPUT ──────────────────────────────────────────────
        function setInputState(input, errorEl, state, message) {
            input.classList.remove('input-valid', 'input-error-border');
            errorEl.textContent = message;

            if (state === 'error') {
                input.classList.add('input-error-border');
                errorEl.style.display = 'block';
            } else if (state === 'success') {
                input.classList.add('input-valid');
                errorEl.style.display = 'none';
            } else {
                errorEl.style.display = 'none';
            }
        }

        // ─── UPDATE TOMBOL BELI ───────────────────────────────────────────
        function updateBuyState() {
            const btnBuy = document.getElementById('btnBuy');
            const selectedInfo = document.getElementById('selectedInfo');

            selectedInfo.style.display = selectedPkg ? 'block' : 'none';

            if (selectedPkg && selectedPayment) {
                btnBuy.textContent = 'Beli Sekarang';
                btnBuy.classList.add('active');
                return;
            }

            btnBuy.classList.remove('active');
            btnBuy.textContent = selectedPkg ? 'Pilih Pembayaran' : 'Pilih Nominal Dulu';
        }

        // ─── SELECT NOMINAL ───────────────────────────────────────────────
        function selectNominal(el, name, price) {
            document.querySelectorAll('.nominal-card').forEach(card => card.classList.remove('selected'));
            el.classList.add('selected');
            selectedPkg = { name, price };

            document.getElementById('selectedName').textContent = name;
            document.getElementById('selectedPrice').textContent = formatRupiah(price);
            updateBuyState();
        }

        // ─── SELECT PAYMENT ───────────────────────────────────────────────
        function selectPayment(el) {
            document.querySelectorAll('.payment-card').forEach(card => {
                card.classList.remove('selected');
                card.setAttribute('aria-pressed', 'false');
            });

            el.classList.add('selected');
            el.setAttribute('aria-pressed', 'true');
            selectedPayment = el.dataset.paymentName;

            document.getElementById('selectedPayment').textContent = selectedPayment;
            updateBuyState();
        }

        // ─── SUBMIT ORDER ─────────────────────────────────────────────────
        async function submitOrder() {
            // Validasi User ID dulu
            const userId = document.getElementById('userId').value.trim();

            if (!userId) {
                document.getElementById('userId').focus();
                showToast('Masukkan User ID dulu!');
                return;
            }

            if (!validateUserId()) {
                document.getElementById('userId').focus();
                showToast('User ID tidak valid!');
                return;
            }

            if (!validateServerId()) {
                document.getElementById('serverId').focus();
                showToast('Format Server ID salah!');
                return;
            }

            if (!selectedPkg) {
                showToast('Pilih nominal dulu ya!');
                return;
            }

            if (!selectedPayment) {
                showToast('Pilih metode pembayaran dulu!');
                return;
            }

            const serverId = document.getElementById('serverId').value.trim();

            // Disable tombol saat loading
            const btnBuy = document.getElementById('btnBuy');
            btnBuy.disabled = true;
            btnBuy.textContent = 'Memproses...';

            try {
                // Kirim transaksi ke server
                const res = await fetch('/order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        gameId,
                        nominal: selectedPkg.name,
                        price: selectedPkg.price,
                        gameUserId: userId,
                        serverId: serverId || null,
                        payment: selectedPayment
                    })
                });

                const data = await res.json();

                if (!data.success) {
                    showToast(data.error || 'Terjadi kesalahan, coba lagi!');
                    btnBuy.disabled = false;
                    updateBuyState();
                    return;
                }

                // Tampilkan invoice dengan kode dari server
                const invoiceModal = document.getElementById('invoiceModal');
                document.getElementById('invoiceCode').textContent = data.code;
                document.getElementById('invoiceGame').textContent = gameName;
                document.getElementById('invoiceNominal').textContent = selectedPkg.name;
                document.getElementById('invoiceUserId').textContent = sanitize(userId);
                document.getElementById('invoiceServerId').textContent = serverId ? sanitize(serverId) : 'Tidak ada';
                document.getElementById('invoicePayment').textContent = selectedPayment;
                document.getElementById('invoiceTotal').textContent = formatRupiah(selectedPkg.price);

                invoiceModal.hidden = false;
                document.body.classList.add('modal-open');
                setTimeout(() => invoiceModal.classList.add('is-open'), 10);

                showToast('Pesanan berhasil dibuat!', 'success');

            } catch (err) {
                showToast('Gagal terhubung ke server!');
            } finally {
                btnBuy.disabled = false;
                updateBuyState();
            }
        }

        // ─── CLOSE INVOICE ────────────────────────────────────────────────
        function closeInvoice() {
            const invoiceModal = document.getElementById('invoiceModal');
            invoiceModal.classList.remove('is-open');
            document.body.classList.remove('modal-open');

            setTimeout(() => {
                invoiceModal.hidden = true;
            }, 200);
        }

        // ─── RESET ORDER ──────────────────────────────────────────────────
        function resetOrder() {
            closeInvoice();

            selectedPkg = null;
            selectedPayment = null;

            const userIdInput = document.getElementById('userId');
            const serverIdInput = document.getElementById('serverId');

            userIdInput.value = '';
            serverIdInput.value = '';

            // Reset state visual input
            setInputState(userIdInput, document.getElementById('userIdError'), 'default', '');
            setInputState(serverIdInput, document.getElementById('serverIdError'), 'default', '');

            document.getElementById('selectedPayment').textContent = 'Belum dipilih';
            document.querySelectorAll('.nominal-card, .payment-card').forEach(card => {
                card.classList.remove('selected');
                card.setAttribute('aria-pressed', 'false');
            });

            updateBuyState(); // ← fix bug lama: info bar sekarang ikut reset
        }

        // ─── KEYBOARD ESC ─────────────────────────────────────────────────
        document.addEventListener('keydown', event => {
            const invoiceModal = document.getElementById('invoiceModal');
            if (event.key === 'Escape' && !invoiceModal.hidden) {
                closeInvoice();
            }
        });
    </script>
</body>
</html>
